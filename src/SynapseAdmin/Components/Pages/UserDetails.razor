@page "/users/{UserId}"
@using Microsoft.AspNetCore.Authorization
@using SynapseAdmin.Infrastructure.Gateways
@implements IDisposable

@attribute [Authorize]

<PageTitle>@L["UserDetails"] - SynapseAdmin.NET</PageTitle>

<MudText Typo="Typo.h3" Class="mb-6">@L["UserDetails"]</MudText>

@if (MatrixSession.Gateway is not SynapseAdminGateway synapseAdmin)
{
    <MudAlert Severity="Severity.Error" Elevation="2" Class="mb-4">
        @L["SynapseAdminApiRequired"]
    </MudAlert>
}
else if (user == null)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else
{
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Overview"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <div class="d-flex align-center mb-4">
                        @if (!string.IsNullOrEmpty(user.AvatarUrl))
                        {
                            <MudAvatar Size="Size.Large" Class="mr-4">
                                <MudImage Src="@(user.AvatarUrl.StartsWith("mxc://") ? $"/Media/Avatar?mxc={Uri.EscapeDataString(user.AvatarUrl)}" : user.AvatarUrl)" />
                            </MudAvatar>
                        }
                        else
                        {
                            <MudAvatar Color="Color.Primary" Size="Size.Large" Class="mr-4">@(user.DisplayName?.FirstOrDefault() ?? user.UserId.FirstOrDefault())</MudAvatar>
                        }
                        <div>
                            <MudText Typo="Typo.h6">@(string.IsNullOrEmpty(user.DisplayName) ? user.UserId : user.DisplayName)</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@user.UserId</MudText>
                        </div>
                    </div>

                    <MudList T="string" Dense="true">
                        <MudListItem T="string"><b>@L["ID"]:</b> <MudText Typo="Typo.caption" Style="word-break: break-all;">@user.UserId</MudText></MudListItem>
                        <MudListItem T="string"><b>@L["Created"]:</b> @user.CreationTsDateTime.ToString("f")</MudListItem>
                        <MudListItem T="string"><b>@L["Status"]:</b> 
                            @if (user.Deactivated)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">@L["Deactivated"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">@L["Active"]</MudChip>
                            }
                        </MudListItem>
                        <MudListItem T="string"><b>@L["Role"]:</b> 
                            @if (user.Admin)
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">@L["Admin"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small">@L["StandardUser"]</MudChip>
                            }
                        </MudListItem>
                    </MudList>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudCard Elevation="3">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">@L["Actions"]</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeactivateUser" Class="mb-2 mr-2" Disabled="@user.Deactivated">@L["DeactivateUser"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="LoginAsUser" Class="mb-2 mr-2">@L["LoginAsUserShadow"]</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="QuarantineAllMedia" Class="mb-2">@L["QuarantineMedia"]</MudButton>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <MudTabs Class="mt-6" Elevation="3" Rounded="true" ApplyEffectsToContainer="true">
        <MudTabPanel Text="@L["Rooms"]" Icon="@Icons.Material.Filled.MeetingRoom">
            <MudTable Items="user.Memberships" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["RoomId"]</MudTh>
                    <MudTh>@L["Membership"]</MudTh>
                    <MudTh>@L["Actions"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["RoomId"]">@context.RoomId</MudTd>
                    <MudTd DataLabel="@L["Membership"]">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" 
                                 Color="@(context.Membership == "join" ? Color.Success : context.Membership == "invite" ? Color.Info : Color.Default)">
                            @context.Membership
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="@L["Actions"]">
                        <MudButton Href="@($"/rooms/{Uri.EscapeDataString(context.RoomId)}")"
                                   Variant="Variant.Text"
                                   Color="Color.Primary">
                            @L["Details"]
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@L["Media"]" Icon="@Icons.Material.Filled.PermMedia">
             @if (user.Media == null)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="m-4" />
            }
            else
            {
                <MudTable Items="user.Media.Media" @ref="mediaTable" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                    <HeaderContent>
                        <MudTh>@L["MediaId"]</MudTh>
                        <MudTh>@L["FileName"]</MudTh>
                        <MudTh>@L["Type"]</MudTh>
                        <MudTh>@L["Size"]</MudTh>
                        <MudTh>@L["Created"]</MudTh>
                        <MudTh>@L["Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                    <MudTd DataLabel="@L["MediaId"]">
                    <div class="d-flex flex-column">
                    @context.MediaId
                    @if (context.IsQuarantined)
                    {
                        <MudTooltip Text="@($"{L["QuarantinedBy"]}: {context.QuarantinedBy}")">
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Text" Class="mt-1">@L["Quarantined"]</MudChip>
                        </MudTooltip>
                    }
                    </div>
                    </MudTd>
                    <MudTd DataLabel="@L["FileName"]">@context.UploadName</MudTd>
                    <MudTd DataLabel="@L["Type"]">@context.MediaType</MudTd>
                    <MudTd DataLabel="@L["Size"]">@(context.MediaLength / 1024) KB</MudTd>
                    <MudTd DataLabel="@L["Created"]">@DateTimeOffset.FromUnixTimeMilliseconds(context.CreatedTimestamp).DateTime.ToString("g")</MudTd>
                    <MudTd DataLabel="@L["Actions"]">
                    <div class="d-flex">
                    @if (!context.IsQuarantined)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Download" 
                                       Color="Color.Primary" 
                                       Href="@($"/Media/Download?mxc={Uri.EscapeDataString($"mxc://{MatrixSession.Gateway!.ServerName}/{context.MediaId}")}&filename={Uri.EscapeDataString(context.DownloadName)}&mimeType={Uri.EscapeDataString(context.MediaType ?? "application/octet-stream")}")"
                                       Target="_blank"
                                       title="@L["Download"]" />

                        @if (IsPreviewable(context.MediaType))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Secondary" 
                                           OnClick="@(() => ShowPreview(context))"
                                           title="@L["Preview"]" />
                        }

                        <MudIconButton Icon="@Icons.Material.Filled.Block" 
                                       Color="Color.Warning" 
                                       OnClick="@(() => QuarantineSingleMedia(context.MediaId))"
                                       title="@L["Quarantine"]" />
                    }
                    else
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.LockOpen" 
                                       Color="Color.Success" 
                                       OnClick="@(() => UnquarantineSingleMedia(context.MediaId))"
                                       title="@L["Unquarantine"]" />
                    }

                    <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                   Color="Color.Error" 
                                   OnClick="@(() => DeleteSingleMedia(context.MediaId))"
                                   title="@L["Delete"]" />
                    </div>
                    </MudTd>
                    </RowTemplate>

                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}
