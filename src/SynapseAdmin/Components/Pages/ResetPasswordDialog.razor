<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LockReset" Class="mr-3 mb-n1" />
            @L["ResetPassword"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@L["ResetPasswordFor", Target]</MudText>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string" Label="@L["NewPassword"]" @bind-Value="model.Password" InputType="InputType.Password"
                          Required="true" RequiredError="@L["PasswordRequired"]" Immediate="true"
                          Validation="@(new Func<string?, string?>(ValidatePassword))" />
            <MudSwitch T="bool" Label="@L["LogOutAllDevices"]" @bind-Value="model.LogoutDevices" Color="Color.Error" Class="mt-4" />
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                @(IsOwnAccount ? L["LogOutAllDevicesOwnAccountHelper"] : L["LogOutAllDevicesHelper"])
            </MudText>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success)">@L["ResetPassword"]</MudButton>
    </DialogActions>
</MudDialog>
