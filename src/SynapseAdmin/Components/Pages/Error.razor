@page "/Error"
@layout MainLayout

<PageTitle>@L["Error"] - SynapseAdmin.NET</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-6">
        <MudText Typo="Typo.h5">@L["Error"]</MudText>
        <MudText Typo="Typo.body1">@L["AnErrorOccurredProcessingRequest"]</MudText>
    </MudAlert>

    @if (ShowRequestId)
    {
        <MudPaper Elevation="1" Class="pa-4 mb-6">
            <MudText Typo="Typo.body2">
                <strong>@L["RequestId"]:</strong> <code>@RequestId</code>
            </MudText>
        </MudPaper>
    }

    <MudCard Elevation="2">
        <MudCardHeader>
            <CardHeaderContent>
                <MudText Typo="Typo.h6">@L["DevelopmentMode"]</MudText>
            </CardHeaderContent>
        </MudCardHeader>
        <MudCardContent>
            <MudText Typo="Typo.body2" Class="mb-2">
                @L["DevelopmentModeNotice"]
            </MudText>
            <MudText Typo="Typo.body2" Color="Color.Warning">
                <strong>@L["DevelopmentModeWarning"]</strong>
            </MudText>
        </MudCardContent>
    </MudCard>
</MudContainer>
