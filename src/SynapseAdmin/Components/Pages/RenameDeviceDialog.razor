<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.DriveFileRenameOutline" Class="mr-3 mb-n1" />
            @L["RenameDevice"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-4">@L["RenameDeviceFor", DeviceId, Target]</MudText>
        <MudTextField T="string" Label="@L["DeviceName"]" @bind-Value="displayName" Immediate="true"
                      Validation="@(new Func<string?, string?>(ValidateName))"
                      Counter="@MaxLength" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!CanSave)">@L["Rename"]</MudButton>
    </DialogActions>
</MudDialog>
