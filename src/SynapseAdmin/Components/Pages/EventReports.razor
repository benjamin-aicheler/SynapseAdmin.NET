@page "/reports"

@attribute [Authorize]

<PageTitle>@L["EventReports"] - SynapseAdmin.NET</PageTitle>

<MudText Typo="Typo.h3" Class="mb-6">@L["EventReports"]</MudText>

@if (MatrixSession.Gateway is not { SupportsAdminApi: true })
{
    <MudAlert Severity="Severity.Error" Elevation="2" Class="mb-4">
        @L["EventReportApiRequired"]
    </MudAlert>
}
else
{
    <MudToolBar Class="mb-4" WrapContent="true">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ReloadTable" StartIcon="@Icons.Material.Filled.Refresh" Class="mr-4">
            @L["Refresh"]
        </MudButton>
        @* Synapse matches the room and the reporter as part of the ID, and the reported user exactly (#588). *@
        <MudTextField T="string" Value="@_roomId" ValueChanged="@OnRoomIdChanged" Label="@L["EventReportFilterRoomId"]" HelperText="@L["EventReportFilterRoomIdHint"]" Clearable="true" Immediate="true" DebounceInterval="500" Class="mr-4" Style="max-width: 260px;" />
        <MudTextField T="string" Value="@_reporterUserId" ValueChanged="@OnReporterChanged" Label="@L["EventReportFilterReporter"]" HelperText="@L["EventReportFilterReporterHint"]" Clearable="true" Immediate="true" DebounceInterval="500" Class="mr-4" Style="max-width: 260px;" />
        <MudTextField T="string" Value="@_senderUserId" ValueChanged="@OnSenderChanged" Label="@L["EventReportFilterSender"]" HelperText="@L["EventReportFilterSenderHint"]" Clearable="true" Immediate="true" DebounceInterval="500" Style="max-width: 260px;" />
        <MudSpacer />
        @if (totalReports.HasValue)
        {
            if (!IsFiltered)
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(L["TotalReports"], totalReports)</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(L["MatchingEventReportsCount"], totalReports)</MudText>
            }
        }
    </MudToolBar>

    <MudTable ServerData="ServerReload" @ref="table" Hover="true" Breakpoint="Breakpoint.Sm" LoadingProgressColor="Color.Info" Elevation="3">
        <HeaderContent>
            <MudTh>@L["ReportId"]</MudTh>
            <MudTh>@L["Reporter"]</MudTh>
            <MudTh>@L["Sender"]</MudTh>
            <MudTh>@L["Room"]</MudTh>
            <MudTh>@L["Reason"]</MudTh>
            <MudTh>@L["Score"]</MudTh>
            <MudTh>@L["ReportedAt"]</MudTh>
            <MudTh>@L["Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["ReportId"]"><MudText Typo="Typo.caption">@context.Id</MudText></MudTd>
            <MudTd DataLabel="@L["Reporter"]">@context.UserId</MudTd>
            <MudTd DataLabel="@L["Sender"]">@context.Sender</MudTd>
            <MudTd DataLabel="@L["Room"]">@(string.IsNullOrEmpty(context.CanonicalAlias) ? context.RoomId : context.CanonicalAlias)</MudTd>
            <MudTd DataLabel="@L["Reason"]">@(string.IsNullOrEmpty(context.Reason) ? "-" : context.Reason)</MudTd>
            <MudTd DataLabel="@L["Score"]">@context.Score</MudTd>
            <MudTd DataLabel="@L["ReportedAt"]">@TimeZoneService.ToLocal(context.ReceivedTsDateTime).ToString("g")</MudTd>
            <MudTd DataLabel="@L["Actions"]">
                <div class="d-flex align-center gap-1">
                    @if (!string.IsNullOrEmpty(context.EventId))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Troubleshoot" 
                                       Size="Size.Small" 
                                       Color="Color.Primary" 
                                       Href="@($"/event-forensics?eventId={Uri.EscapeDataString(context.EventId)}")" 
                                       title="@L["InspectEvent"]" />
                    }
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" OnClick="@(() => ShowDetails(context.Id))">@L["Details"]</MudButton>
                    <MudButton Variant="Variant.Filled" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteReport(context.Id))">@L["Dismiss"]</MudButton>
                </div>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText>@L["NoReportsFound"]</MudText>
        </NoRecordsContent>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}
