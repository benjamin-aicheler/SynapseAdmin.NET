<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mr-3 mb-n1" />
            @L["PublishRoomToDirectory"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField T="string" Label="@L["RoomId"]" @bind-Value="roomId" Required="true" 
                          RequiredError="@L["RoomIdRequired"]" HelperText="@L["RoomIdFormatHelper"]" />
            
            <MudSelect T="string" Label="@L["Visibility"]" @bind-Value="visibility" Required="true">
                <MudSelectItem Value="@("public")">@L["Public"]</MudSelectItem>
                <MudSelectItem Value="@("private")">@L["Private"]</MudSelectItem>
            </MudSelect>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || loading)">
            @if (loading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Loading"]</MudText>
            }
            else
            {
                @L["Publish"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>
