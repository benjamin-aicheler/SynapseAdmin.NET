@page "/not-found"
@layout MainLayout

<PageTitle>@L["NotFound"] - SynapseAdmin.NET</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex flex-column align-center justify-center py-12">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Color="Color.Secondary" Style="font-size: 5rem;" />
    <MudText Typo="Typo.h4" Class="mt-4" Align="Align.Center">@L["NotFound"]</MudText>
    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2 mb-6" Align="Align.Center">@L["PageNotFoundMessage"]</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" Href="/">
        @L["BackToHome"]
    </MudButton>
</MudContainer>