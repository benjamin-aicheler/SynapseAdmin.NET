@using Microsoft.Extensions.Localization
@using SynapseAdmin.Resources
@inject IStringLocalizer<SharedResources> L

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Class="mr-3 mb-n1" />
            @L["RenewAccount"]
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            @L["RenewAccountDescription"]
        </MudText>

        <MudForm @ref="form" @bind-IsValid="@success">
            <MudRadioGroup T="string" @bind-Value="expirationType" Class="mb-4 d-flex flex-column">
                <MudRadio Value="@("default")" Color="Color.Primary">@L["UseServerDefaultPeriod"]</MudRadio>
                <MudRadio Value="@("custom")" Color="Color.Primary">@L["SetCustomExpirationDate"]</MudRadio>
            </MudRadioGroup>

            @if (expirationType == "custom")
            {
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="@L["SelectDate"]" @bind-Date="selectedDate" Required="true" RequiredError="@L["InvalidDateOrTime"]" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTimePicker Label="@L["SelectTime"]" @bind-Time="selectedTime" Required="true" RequiredError="@L["InvalidDateOrTime"]" />
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                    @L["TimeZone"]: @ActiveTimeZoneDisplay
                    @if (!string.IsNullOrEmpty(ResolvedUtcPreview))
                    {
                        @($" ({ResolvedUtcPreview})")
                    }
                </MudText>
            }

            <div class="mt-6">
                <MudSwitch T="bool" Label="@L["EnableRenewalEmails"]" @bind-Value="enableRenewalEmails" Color="Color.Primary" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-n2 ml-3">
                    @L["EnableRenewalEmailsHelp"]
                </MudText>
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!success || loading)">
            @if (loading)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Class="ms-2">@L["Loading"]</MudText>
            }
            else
            {
                @L["RenewAccount"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

